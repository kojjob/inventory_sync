<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-4 sm:p-6 lg:p-8">
  <div class="w-full max-w-6xl">
    <!-- Development Notice -->
    <div
      :if={local_mail_adapter?()}
      class="mb-6 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 p-4 backdrop-blur-sm"
    >
      <div class="flex gap-3">
        <.icon name="hero-information-circle" class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" />
        <div class="text-sm text-emerald-200">
          <p class="font-medium mb-1">Development Mode</p>
          <p class="text-emerald-300">
            Check
            <.link href="/dev/mailbox" class="underline font-medium hover:text-emerald-100">
              the mailbox
            </.link>
            for login links.
          </p>
        </div>
      </div>
    </div>

    <!-- Main Split Panel -->
    <div class="bg-slate-800/50 backdrop-blur-sm rounded-3xl shadow-2xl overflow-hidden grid lg:grid-cols-2 border border-slate-700/50">
      <!-- Left Panel - Form -->
      <div class="p-8 sm:p-12 lg:p-16">
        <!-- Logo/Brand -->
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 bg-gradient-to-br from-emerald-400 to-teal-500 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-white">InventorySync</h1>
        </div>

        <!-- Welcome Text -->
        <div class="mb-8">
          <%= if @current_scope do %>
            <h2 class="text-3xl font-bold text-white mb-2">Reauthenticate</h2>
            <p class="text-slate-400">Confirm your identity to continue</p>
          <% else %>
            <h2 id="auth-title" class="text-3xl font-bold text-white mb-2">Welcome Back!</h2>
            <p id="auth-subtitle" class="text-slate-400">We Are Happy To See You Again</p>
          <% end %>
        </div>

        <!-- Tab Navigation -->
        <div class="flex gap-2 mb-8">
          <button
            id="signin-tab"
            onclick="switchTab('signin')"
            class="flex-1 px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-medium rounded-xl transition-all shadow-lg shadow-emerald-500/25"
          >
            Sign in
          </button>
          <button
            id="signup-tab"
            onclick="switchTab('signup')"
            class="flex-1 px-6 py-3 bg-slate-700/50 text-slate-300 font-medium rounded-xl border border-slate-600 hover:border-slate-500 hover:text-white transition-all"
          >
            Sign Up
          </button>
        </div>

        <!-- Sign In Form -->
        <div id="signin-form" style="display: block;">
          <.form
            :let={f}
            for={@form}
            as={:user}
            id="login_form"
            action={~p"/users/log-in"}
            class="space-y-5"
          >
            <!-- Email Input -->
            <div>
              <div class="relative">
                <.input
                  readonly={!!@current_scope}
                  field={f[:email]}
                  type="email"
                  autocomplete="email"
                  required
                  phx-mounted={JS.focus()}
                  class="block w-full px-4 py-3.5 pr-12 bg-slate-700/50 border border-slate-600 rounded-xl text-white placeholder-slate-400 focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
                  placeholder="Enter your email"
                />
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
                  <.icon name="hero-envelope" class="h-5 w-5 text-slate-400" />
                </div>
              </div>
            </div>

            <!-- Password Input -->
            <div>
              <div class="relative">
                <.input
                  field={f[:password]}
                  type="password"
                  autocomplete="current-password"
                  class="block w-full px-4 py-3.5 pr-12 bg-slate-700/50 border border-slate-600 rounded-xl text-white placeholder-slate-400 focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
                  placeholder="Enter your password"
                />
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
                  <.icon name="hero-eye-slash" class="h-5 w-5 text-slate-400" />
                </div>
              </div>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="flex items-center justify-between">
              <label class="flex items-center cursor-pointer group">
                <input
                  type="checkbox"
                  name={f[:remember_me].name}
                  value="true"
                  class="w-4 h-4 rounded border-slate-600 bg-slate-700 text-emerald-500 focus:ring-emerald-500 focus:ring-offset-slate-800 cursor-pointer"
                />
                <span class="ml-2 text-sm text-slate-400 group-hover:text-white transition-colors">
                  Remember me
                </span>
              </label>
              <.link
                href={~p"/users/reset-password"}
                class="text-sm text-emerald-400 hover:text-emerald-300 font-medium transition-colors"
              >
                Forgot Password?
              </.link>
            </div>

            <!-- Login Button -->
            <button
              type="submit"
              name={f[:remember_me].name}
              value="true"
              class="w-full px-6 py-4 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-semibold rounded-xl shadow-lg shadow-emerald-500/25 hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-slate-800 focus:ring-emerald-500"
            >
              Login
            </button>
          </.form>

          <!-- Divider -->
          <div class="relative my-8">
            <div class="absolute inset-0 flex items-center">
              <div class="w-full border-t border-slate-600"></div>
            </div>
            <div class="relative flex justify-center text-sm">
              <span class="px-4 bg-slate-800/50 text-slate-400 font-medium">
                OR
              </span>
            </div>
          </div>

          <!-- Social Login Buttons -->
          <div class="space-y-3">
            <button
              type="button"
              disabled
              class="w-full px-6 py-3.5 bg-white text-gray-900 font-medium rounded-xl flex items-center justify-center gap-3 opacity-50 cursor-not-allowed transition-all"
            >
              <.icon name="hero-device-phone-mobile" class="w-5 h-5" /> Log in with Apple
            </button>
            <button
              type="button"
              disabled
              class="w-full px-6 py-3.5 bg-slate-700/50 border border-slate-600 text-slate-300 font-medium rounded-xl flex items-center justify-center gap-3 opacity-50 cursor-not-allowed transition-all"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path
                  fill="#4285F4"
                  d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                />
                <path
                  fill="#34A853"
                  d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                />
                <path
                  fill="#FBBC05"
                  d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                />
                <path
                  fill="#EA4335"
                  d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                />
              </svg>
              Log in with Google
            </button>
          </div>

          <!-- Magic Link Alternative -->
          <details class="mt-8">
            <summary class="text-sm text-slate-400 hover:text-white cursor-pointer font-medium">
              Prefer passwordless login?
            </summary>
            <.form
              :let={f}
              for={@form}
              as={:user}
              id="login_form_magic"
              action={~p"/users/log-in"}
              class="mt-4 space-y-4"
            >
              <div class="relative">
                <.input
                  readonly={!!@current_scope}
                  field={f[:email]}
                  type="email"
                  autocomplete="email"
                  required
                  class="block w-full px-4 py-3.5 pr-12 bg-slate-700/50 border border-slate-600 rounded-xl text-white placeholder-slate-400 focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
                  placeholder="Enter your email"
                />
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
                  <.icon name="hero-envelope" class="h-5 w-5 text-slate-400" />
                </div>
              </div>
              <button
                type="submit"
                class="w-full px-6 py-3.5 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-xl transition-colors flex items-center justify-center gap-2 shadow-lg shadow-purple-500/25"
              >
                Send Magic Link <.icon name="hero-paper-airplane" class="w-4 h-4" />
              </button>
            </.form>
          </details>
        </div>

        <!-- Sign Up Form -->
        <div id="signup-form" style="display: none;">
          <.form
            :let={f}
            for={@form}
            as={:user}
            id="registration_form"
            action={~p"/users/register"}
            class="space-y-5"
          >
            <!-- Email Input -->
            <div>
              <div class="relative">
                <.input
                  field={f[:email]}
                  type="email"
                  autocomplete="email"
                  required
                  phx-mounted={JS.focus()}
                  class="block w-full px-4 py-3.5 pr-12 bg-slate-700/50 border border-slate-600 rounded-xl text-white placeholder-slate-400 focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
                  placeholder="Enter your email"
                />
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
                  <.icon name="hero-envelope" class="h-5 w-5 text-slate-400" />
                </div>
              </div>
              <p class="mt-2 text-xs text-slate-400">
                We'll send you a magic link to verify your email
              </p>
            </div>

            <!-- Password Input -->
            <div>
              <div class="relative">
                <.input
                  field={f[:password]}
                  type="password"
                  autocomplete="new-password"
                  class="block w-full px-4 py-3.5 pr-12 bg-slate-700/50 border border-slate-600 rounded-xl text-white placeholder-slate-400 focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
                  placeholder="Create a password (optional)"
                />
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
                  <.icon name="hero-lock-closed" class="h-5 w-5 text-slate-400" />
                </div>
              </div>
              <p class="mt-2 text-xs text-slate-400">
                Or use magic link authentication for password-less login
              </p>
            </div>

            <!-- Terms Agreement -->
            <div class="rounded-xl bg-slate-700/30 p-4 border border-slate-600/50">
              <p class="text-xs text-slate-400 leading-relaxed">
                By creating an account, you agree to our
                <a href="/terms" class="text-emerald-400 hover:underline font-medium">
                  Terms of Service
                </a>
                and
                <a href="/privacy" class="text-emerald-400 hover:underline font-medium">
                  Privacy Policy
                </a>
              </p>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              phx-disable-with="Creating account..."
              class="w-full px-6 py-4 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-semibold rounded-xl shadow-lg shadow-emerald-500/25 hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-slate-800 focus:ring-emerald-500"
            >
              Create Account
            </button>
          </.form>

          <!-- Features List -->
          <div class="mt-8 pt-6 border-t border-slate-700">
            <p class="text-xs font-medium text-slate-500 mb-3 uppercase tracking-wide">
              What you'll get
            </p>
            <ul class="space-y-2">
              <li class="flex items-start gap-3">
                <div class="mt-0.5 flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center">
                  <.icon name="hero-check" class="w-3 h-3 text-emerald-400" />
                </div>
                <span class="text-sm text-slate-400">Real-time inventory synchronization</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="mt-0.5 flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center">
                  <.icon name="hero-check" class="w-3 h-3 text-emerald-400" />
                </div>
                <span class="text-sm text-slate-400">Multi-channel product management</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="mt-0.5 flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500/20 flex items-center justify-center">
                  <.icon name="hero-check" class="w-3 h-3 text-emerald-400" />
                </div>
                <span class="text-sm text-slate-400">Advanced analytics and reporting</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Right Panel - Gradient Artwork -->
      <div class="hidden lg:flex relative bg-gradient-to-br from-emerald-600 via-teal-600 to-cyan-700 overflow-hidden">
        <!-- Animated Gradient Overlay -->
        <div class="absolute inset-0 opacity-30">
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-400 via-teal-500 to-cyan-600 animate-pulse">
          </div>
          <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-emerald-400 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob">
          </div>
          <div class="absolute top-1/3 right-1/4 w-96 h-96 bg-teal-400 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob animation-delay-2000">
          </div>
          <div class="absolute bottom-1/4 left-1/3 w-96 h-96 bg-cyan-400 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob animation-delay-4000">
          </div>
        </div>

        <!-- Wave Pattern SVG -->
        <svg
          class="absolute inset-0 w-full h-full opacity-20"
          viewBox="0 0 1200 800"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <linearGradient id="wave-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#34d399;stop-opacity:1" />
              <stop offset="100%" style="stop-color:#14b8a6;stop-opacity:1" />
            </linearGradient>
          </defs>
          <path
            d="M0,400 Q300,200 600,400 T1200,400 L1200,800 L0,800 Z"
            fill="url(#wave-gradient)"
            opacity="0.3"
          >
            <animate
              attributeName="d"
              dur="10s"
              repeatCount="indefinite"
              values="M0,400 Q300,200 600,400 T1200,400 L1200,800 L0,800 Z;
                      M0,400 Q300,600 600,400 T1200,400 L1200,800 L0,800 Z;
                      M0,400 Q300,200 600,400 T1200,400 L1200,800 L0,800 Z"
            />
          </path>
          <path
            d="M0,500 Q300,300 600,500 T1200,500 L1200,800 L0,800 Z"
            fill="url(#wave-gradient)"
            opacity="0.2"
          >
            <animate
              attributeName="d"
              dur="8s"
              repeatCount="indefinite"
              values="M0,500 Q300,300 600,500 T1200,500 L1200,800 L0,800 Z;
                      M0,500 Q300,700 600,500 T1200,500 L1200,800 L0,800 Z;
                      M0,500 Q300,300 600,500 T1200,500 L1200,800 L0,800 Z"
            />
          </path>
        </svg>

        <!-- Content -->
        <div class="relative z-10 flex flex-col justify-end p-12 text-white">
          <div class="max-w-md">
            <h3 class="text-3xl font-bold mb-4 drop-shadow-lg">
              Sync Your Inventory Across All Channels
            </h3>
            <p class="text-emerald-100 text-lg drop-shadow-md mb-8">
              Real-time synchronization for Shopify, Etsy, Amazon, and more. Manage your multi-channel inventory from one powerful platform.
            </p>
          </div>

          <!-- Copyright Footer -->
          <div class="mt-auto pt-8 border-t border-white/20">
            <p class="text-sm text-emerald-100">
              © 2024 InventorySync. All rights reserved.
            </p>
            <p class="text-xs text-emerald-200 mt-1">
              Unauthorized use or reproduction of any content is prohibited.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes blob {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    25% {
      transform: translate(20px, -50px) scale(1.1);
    }
    50% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    75% {
      transform: translate(50px, 50px) scale(1.05);
    }
  }

  .animate-blob {
    animation: blob 7s infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>

<script>
  function switchTab(tab) {
    const signinTab = document.getElementById('signin-tab');
    const signupTab = document.getElementById('signup-tab');
    const signinForm = document.getElementById('signin-form');
    const signupForm = document.getElementById('signup-form');
    const title = document.getElementById('auth-title');
    const subtitle = document.getElementById('auth-subtitle');

    if (tab === 'signin') {
      // Update tabs
      signinTab.className = 'flex-1 px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-medium rounded-xl transition-all shadow-lg shadow-emerald-500/25';
      signupTab.className = 'flex-1 px-6 py-3 bg-slate-700/50 text-slate-300 font-medium rounded-xl border border-slate-600 hover:border-slate-500 hover:text-white transition-all';

      // Update forms
      signinForm.style.display = 'block';
      signupForm.style.display = 'none';

      // Update text
      if (title) title.textContent = 'Welcome Back!';
      if (subtitle) subtitle.textContent = 'We Are Happy To See You Again';
    } else {
      // Update tabs
      signinTab.className = 'flex-1 px-6 py-3 bg-slate-700/50 text-slate-300 font-medium rounded-xl border border-slate-600 hover:border-slate-500 hover:text-white transition-all';
      signupTab.className = 'flex-1 px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-medium rounded-xl transition-all shadow-lg shadow-emerald-500/25';

      // Update forms
      signinForm.style.display = 'none';
      signupForm.style.display = 'block';

      // Update text
      if (title) title.textContent = 'Create Account';
      if (subtitle) subtitle.textContent = 'Join us and start managing your inventory';
    }
  }
</script>
