<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 px-4 sm:px-6 lg:px-8 py-12">
  <div class="w-full max-w-md">
    <!-- Header -->
    <div class="text-center mb-8">
      <div class="inline-block p-4 rounded-3xl bg-gradient-to-br from-emerald-500 to-green-600 shadow-lg mb-4">
        <.icon name="hero-check-circle" class="w-12 h-12 text-white" />
      </div>
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
        {if @user.confirmed_at, do: "Already Confirmed!", else: "Confirm Your Email"}
      </h2>
      <p class="text-gray-600 dark:text-gray-400">
        Welcome {@user.email}
      </p>
    </div>
    
<!-- Main Card -->
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300 hover:shadow-2xl">
      <div class="p-8">
        <!-- Unconfirmed State - Confirm Email -->
        <.form
          :if={!@user.confirmed_at}
          for={@form}
          id="confirmation_form"
          action={~p"/users/log-in?_action=confirmed"}
          phx-mounted={JS.focus_first()}
          class="space-y-4"
        >
          <input type="hidden" name={@form[:token].name} value={@form[:token].value} />

          <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-2xl p-4 mb-6">
            <div class="flex gap-3">
              <.icon
                name="hero-information-circle"
                class="w-5 h-5 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5"
              />
              <div class="text-sm text-emerald-900 dark:text-emerald-200">
                <p class="font-medium mb-1">Confirm your email to continue</p>
                <p class="text-emerald-700 dark:text-emerald-300">
                  Click one of the options below to activate your account
                </p>
              </div>
            </div>
          </div>

          <button
            type="submit"
            name={@form[:remember_me].name}
            value="true"
            phx-disable-with="Confirming..."
            class="w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-700 hover:to-green-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 dark:focus:ring-offset-gray-800"
          >
            <.icon name="hero-check-circle" class="w-5 h-5" /> Confirm and stay logged in
          </button>

          <button
            type="submit"
            phx-disable-with="Confirming..."
            class="w-full px-6 py-3.5 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 text-emerald-600 dark:text-emerald-400 font-semibold rounded-xl border-2 border-emerald-600 dark:border-emerald-400 shadow hover:shadow-md transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 dark:focus:ring-offset-gray-800"
          >
            Confirm and log in only this time
          </button>
        </.form>
        
<!-- Already Confirmed State - Login Options -->
        <.form
          :if={@user.confirmed_at}
          for={@form}
          id="login_form"
          action={~p"/users/log-in"}
          phx-mounted={JS.focus_first()}
          class="space-y-4"
        >
          <input type="hidden" name={@form[:token].name} value={@form[:token].value} />

          <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-2xl p-4 mb-6">
            <div class="flex gap-3">
              <.icon
                name="hero-check-badge"
                class="w-5 h-5 text-blue-600 dark:text-blue-400 shrink-0 mt-0.5"
              />
              <div class="text-sm text-blue-900 dark:text-blue-200">
                <p class="font-medium mb-1">Email already confirmed</p>
                <p class="text-blue-700 dark:text-blue-300">
                  Choose how you'd like to log in
                </p>
              </div>
            </div>
          </div>

          <%= if @current_scope do %>
            <button
              type="submit"
              phx-disable-with="Logging in..."
              class="w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:focus:ring-offset-gray-800"
            >
              <.icon name="hero-arrow-right" class="w-5 h-5" /> Log in
            </button>
          <% else %>
            <button
              type="submit"
              name={@form[:remember_me].name}
              value="true"
              phx-disable-with="Logging in..."
              class="w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:focus:ring-offset-gray-800"
            >
              <.icon name="hero-device-phone-mobile" class="w-5 h-5" />
              Keep me logged in on this device
            </button>

            <button
              type="submit"
              phx-disable-with="Logging in..."
              class="w-full px-6 py-3.5 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 text-blue-600 dark:text-blue-400 font-semibold rounded-xl border-2 border-blue-600 dark:border-blue-400 shadow hover:shadow-md transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:focus:ring-offset-gray-800"
            >
              Log me in only this time
            </button>
          <% end %>
        </.form>
        
<!-- Password Tip -->
        <div
          :if={!@user.confirmed_at}
          class="mt-8 rounded-2xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 p-4"
        >
          <div class="flex gap-3">
            <.icon
              name="hero-light-bulb"
              class="w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5"
            />
            <div class="text-sm text-amber-900 dark:text-amber-200">
              <p class="font-medium mb-1">Tip</p>
              <p class="text-amber-700 dark:text-amber-300">
                If you prefer passwords, you can enable them in the user settings after confirming.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
<!-- Security Notice -->
    <p class="mt-6 text-center text-xs text-gray-500 dark:text-gray-500 flex items-center justify-center gap-2">
      <.icon name="hero-shield-check" class="w-4 h-4" />
      <span>Secure email confirmation</span>
    </p>
  </div>
</div>
