<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 px-4 sm:px-6 lg:px-8 py-12">
  <!-- Animated background blobs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl animate-pulse">
    </div>
    <div
      class="absolute -bottom-40 -left-40 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl animate-pulse"
      style="animation-delay: 1s;"
    >
    </div>
  </div>

  <div class="w-full max-w-md relative z-10">
    <!-- Header -->
    <div class="text-center mb-8">
      <div class="inline-block p-4 rounded-3xl bg-gradient-to-br from-emerald-400 to-teal-500 shadow-lg shadow-emerald-500/25 mb-4">
        <.icon name="hero-check-circle" class="w-12 h-12 text-white" />
      </div>
      <h2 class="text-3xl font-bold text-white mb-2">
        {if @user.confirmed_at, do: "Already Confirmed!", else: "Confirm Your Email"}
      </h2>
      <p class="text-slate-400">
        Welcome {@user.email}
      </p>
    </div>
    
<!-- Main Card -->
    <div class="bg-slate-800/50 backdrop-blur-sm rounded-3xl shadow-2xl border border-slate-700/50 overflow-hidden transition-all duration-300 hover:shadow-emerald-500/5">
      <div class="p-8">
        <!-- Unconfirmed State - Confirm Email -->
        <.form
          :if={!@user.confirmed_at}
          for={@form}
          id="confirmation_form"
          action={~p"/users/log-in?_action=confirmed"}
          phx-mounted={JS.focus_first()}
          class="space-y-4"
        >
          <input type="hidden" name={@form[:token].name} value={@form[:token].value} />

          <div class="bg-emerald-900/30 border border-emerald-700/50 rounded-2xl p-4 mb-6">
            <div class="flex gap-3">
              <.icon
                name="hero-information-circle"
                class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5"
              />
              <div class="text-sm text-emerald-200">
                <p class="font-medium mb-1">Confirm your email to continue</p>
                <p class="text-emerald-300/80">
                  Click one of the options below to activate your account
                </p>
              </div>
            </div>
          </div>

          <button
            type="submit"
            name={@form[:remember_me].name}
            value="true"
            phx-disable-with="Confirming..."
            class="w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-semibold rounded-xl shadow-lg shadow-emerald-500/25 hover:shadow-xl hover:shadow-emerald-500/30 transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 focus:ring-offset-slate-800"
          >
            <.icon name="hero-check-circle" class="w-5 h-5" /> Confirm and stay logged in
          </button>

          <button
            type="submit"
            phx-disable-with="Confirming..."
            class="w-full px-6 py-3.5 bg-slate-700/50 hover:bg-slate-700 text-emerald-400 font-semibold rounded-xl border border-emerald-500/50 hover:border-emerald-500 shadow hover:shadow-md transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 focus:ring-offset-slate-800"
          >
            Confirm and log in only this time
          </button>
        </.form>
        
<!-- Already Confirmed State - Login Options -->
        <.form
          :if={@user.confirmed_at}
          for={@form}
          id="login_form"
          action={~p"/users/log-in"}
          phx-mounted={JS.focus_first()}
          class="space-y-4"
        >
          <input type="hidden" name={@form[:token].name} value={@form[:token].value} />

          <div class="bg-teal-900/30 border border-teal-700/50 rounded-2xl p-4 mb-6">
            <div class="flex gap-3">
              <.icon
                name="hero-check-badge"
                class="w-5 h-5 text-teal-400 shrink-0 mt-0.5"
              />
              <div class="text-sm text-teal-200">
                <p class="font-medium mb-1">Email already confirmed</p>
                <p class="text-teal-300/80">
                  Choose how you'd like to log in
                </p>
              </div>
            </div>
          </div>

          <%= if @current_scope do %>
            <button
              type="submit"
              phx-disable-with="Logging in..."
              class="w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-semibold rounded-xl shadow-lg shadow-emerald-500/25 hover:shadow-xl hover:shadow-emerald-500/30 transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 focus:ring-offset-slate-800"
            >
              <.icon name="hero-arrow-right" class="w-5 h-5" /> Log in
            </button>
          <% else %>
            <button
              type="submit"
              name={@form[:remember_me].name}
              value="true"
              phx-disable-with="Logging in..."
              class="w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-semibold rounded-xl shadow-lg shadow-emerald-500/25 hover:shadow-xl hover:shadow-emerald-500/30 transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 focus:ring-offset-slate-800"
            >
              <.icon name="hero-device-phone-mobile" class="w-5 h-5" />
              Keep me logged in on this device
            </button>

            <button
              type="submit"
              phx-disable-with="Logging in..."
              class="w-full px-6 py-3.5 bg-slate-700/50 hover:bg-slate-700 text-emerald-400 font-semibold rounded-xl border border-emerald-500/50 hover:border-emerald-500 shadow hover:shadow-md transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 focus:ring-offset-slate-800"
            >
              Log me in only this time
            </button>
          <% end %>
        </.form>
        
<!-- Password Tip -->
        <div
          :if={!@user.confirmed_at}
          class="mt-8 rounded-2xl bg-amber-900/30 border border-amber-700/50 p-4"
        >
          <div class="flex gap-3">
            <.icon
              name="hero-light-bulb"
              class="w-5 h-5 text-amber-400 shrink-0 mt-0.5"
            />
            <div class="text-sm text-amber-200">
              <p class="font-medium mb-1">Tip</p>
              <p class="text-amber-300/80">
                If you prefer passwords, you can enable them in the user settings after confirming.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
<!-- Security Notice -->
    <p class="mt-6 text-center text-xs text-slate-500 flex items-center justify-center gap-2">
      <.icon name="hero-shield-check" class="w-4 h-4" />
      <span>Secure email confirmation</span>
    </p>
  </div>
</div>
