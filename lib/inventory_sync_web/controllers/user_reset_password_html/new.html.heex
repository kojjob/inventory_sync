<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 px-4 sm:px-6 lg:px-8 py-12">
  <!-- Animated background blobs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl animate-pulse">
    </div>
    <div
      class="absolute -bottom-40 -left-40 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl animate-pulse"
      style="animation-delay: 1s;"
    >
    </div>
  </div>

  <div class="w-full max-w-md relative z-10">
    <!-- Header -->
    <div class="text-center mb-8">
      <div class="inline-block p-4 rounded-3xl bg-gradient-to-br from-emerald-400 to-teal-500 shadow-lg shadow-emerald-500/25 mb-4">
        <.icon name="hero-key" class="w-12 h-12 text-white" />
      </div>
      <h2 class="text-3xl font-bold text-white mb-2">Reset your password</h2>
      <p class="text-slate-400">
        Enter your email to receive reset instructions
      </p>
    </div>
    
<!-- Main Card -->
    <div class="bg-slate-800/50 backdrop-blur-sm rounded-3xl shadow-2xl border border-slate-700/50 overflow-hidden transition-all duration-300 hover:shadow-emerald-500/5">
      <div class="p-8">
        <.form for={@form} as={:user} action={~p"/users/reset-password"} class="space-y-5">
          <!-- Email Field -->
          <div>
            <label
              for={@form[:email].id}
              class="block text-sm font-medium text-slate-300 mb-2"
            >
              Email address
            </label>
            <div class="relative rounded-xl shadow-sm">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
                <.icon name="hero-envelope" class="h-5 w-5 text-slate-400" />
              </div>
              <.input
                field={@form[:email]}
                type="email"
                autocomplete="email"
                required
                phx-mounted={JS.focus()}
                class="block w-full pl-12 pr-4 py-3 bg-slate-700/50 border border-slate-600 rounded-xl text-white placeholder-slate-400 focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-colors"
                placeholder="you@example.com"
              />
            </div>
            <p class="mt-2 text-xs text-slate-400">
              We'll send you instructions to reset your password
            </p>
          </div>
          
<!-- Submit Button -->
          <div>
            <.button
              type="submit"
              class="w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-xl shadow-lg shadow-emerald-500/25 text-sm font-semibold text-white bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 focus:ring-offset-slate-800 transition-all duration-200 transform hover:-translate-y-0.5 hover:shadow-xl hover:shadow-emerald-500/30"
            >
              <.icon name="hero-paper-airplane" class="w-5 h-5 mr-2" /> Send reset instructions
            </.button>
          </div>
        </.form>
      </div>
      
<!-- Footer -->
      <div class="px-8 py-6 bg-slate-900/50 border-t border-slate-700/50">
        <div class="flex items-center justify-between text-sm">
          <.link
            navigate={~p"/users/register"}
            class="text-emerald-400 hover:text-emerald-300 font-medium transition-colors flex items-center group"
          >
            <.icon
              name="hero-user-plus"
              class="w-4 h-4 mr-1.5 group-hover:-translate-x-0.5 transition-transform"
            /> Create account
          </.link>
          <.link
            navigate={~p"/users/log-in"}
            class="text-emerald-400 hover:text-emerald-300 font-medium transition-colors flex items-center group"
          >
            Back to login
            <.icon
              name="hero-arrow-right"
              class="w-4 h-4 ml-1.5 group-hover:translate-x-0.5 transition-transform"
            />
          </.link>
        </div>
      </div>
    </div>
  </div>
</div>
