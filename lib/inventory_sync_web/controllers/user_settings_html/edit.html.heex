<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Page Header -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-2">
      <div class="p-2 rounded-xl bg-gradient-to-br from-purple-500 to-indigo-600 shadow-lg">
        <.icon name="hero-user-circle" class="w-6 h-6 text-white" />
      </div>
      <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Account Settings</h1>
        <p class="text-gray-600 dark:text-gray-400 mt-1">
          Manage your account email address and password settings
        </p>
      </div>
    </div>
  </div>

  <div class="grid gap-6">
    <!-- Email Settings Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50">
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-lg bg-blue-100 dark:bg-blue-900/30">
            <.icon name="hero-envelope" class="w-5 h-5 text-blue-600 dark:text-blue-400" />
          </div>
          <div>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Email Address</h2>
            <p class="text-sm text-gray-600 dark:text-gray-400">Update your email address</p>
          </div>
        </div>
      </div>

      <div class="p-6">
        <.form :let={f} for={@email_changeset} action={~p"/users/settings"} id="update_email" class="space-y-5">
          <input type="hidden" name="action" value="update_email" />

          <div>
            <label for={f[:email].id} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Email address
            </label>
            <div class="relative rounded-xl shadow-sm">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
                <.icon name="hero-envelope" class="h-5 w-5 text-gray-400" />
              </div>
              <.input
                field={f[:email]}
                type="email"
                autocomplete="email"
                required
                class="block w-full pl-12 pr-4 py-3 bg-gray-50 dark:bg-gray-900 border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
                placeholder="your@email.com"
              />
            </div>
          </div>

          <div class="rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 p-4">
            <div class="flex gap-3">
              <.icon name="hero-information-circle" class="w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" />
              <div class="text-sm text-amber-900 dark:text-amber-200">
                <p class="font-medium mb-1">Email change confirmation</p>
                <p class="text-amber-700 dark:text-amber-300">
                  We will send a confirmation email to both your current and new email addresses.
                </p>
              </div>
            </div>
          </div>

          <button
            type="submit"
            phx-disable-with="Changing..."
            class="w-full flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:focus:ring-offset-gray-800"
          >
            <.icon name="hero-check" class="w-5 h-5" />
            Change Email
          </button>
        </.form>
      </div>
    </div>

    <!-- Password Settings Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50">
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-lg bg-purple-100 dark:bg-purple-900/30">
            <.icon name="hero-lock-closed" class="w-5 h-5 text-purple-600 dark:text-purple-400" />
          </div>
          <div>
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Password</h2>
            <p class="text-sm text-gray-600 dark:text-gray-400">Update your password</p>
          </div>
        </div>
      </div>

      <div class="p-6">
        <.form :let={f} for={@password_changeset} action={~p"/users/settings"} id="update_password" class="space-y-5">
          <input type="hidden" name="action" value="update_password" />

          <div>
            <label for={f[:password].id} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              New password
            </label>
            <div class="relative rounded-xl shadow-sm">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
                <.icon name="hero-lock-closed" class="h-5 w-5 text-gray-400" />
              </div>
              <.input
                field={f[:password]}
                type="password"
                autocomplete="new-password"
                required
                class="block w-full pl-12 pr-4 py-3 bg-gray-50 dark:bg-gray-900 border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-colors"
                placeholder="••••••••"
              />
            </div>
            <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
              Must be at least 8 characters long
            </p>
          </div>

          <div>
            <label for={f[:password_confirmation].id} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Confirm new password
            </label>
            <div class="relative rounded-xl shadow-sm">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
                <.icon name="hero-lock-closed" class="h-5 w-5 text-gray-400" />
              </div>
              <.input
                field={f[:password_confirmation]}
                type="password"
                autocomplete="new-password"
                required
                class="block w-full pl-12 pr-4 py-3 bg-gray-50 dark:bg-gray-900 border-gray-300 dark:border-gray-600 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-colors"
                placeholder="••••••••"
              />
            </div>
          </div>

          <div class="rounded-xl bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 p-4">
            <div class="flex gap-3">
              <.icon name="hero-shield-check" class="w-5 h-5 text-blue-600 dark:text-blue-400 shrink-0 mt-0.5" />
              <div class="text-sm text-blue-900 dark:text-blue-200">
                <p class="font-medium mb-1">Security best practices</p>
                <ul class="text-blue-700 dark:text-blue-300 space-y-1 list-disc list-inside">
                  <li>Use a unique password you haven't used elsewhere</li>
                  <li>Include uppercase, lowercase, numbers, and symbols</li>
                  <li>Avoid common words or personal information</li>
                </ul>
              </div>
            </div>
          </div>

          <button
            type="submit"
            phx-disable-with="Changing..."
            class="w-full flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 dark:focus:ring-offset-gray-800"
          >
            <.icon name="hero-check" class="w-5 h-5" />
            Save Password
          </button>
        </.form>
      </div>
    </div>

    <!-- Security Notice -->
    <div class="rounded-xl bg-gray-50 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-700 p-4">
      <div class="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400">
        <.icon name="hero-shield-check" class="w-5 h-5 text-emerald-600 dark:text-emerald-400" />
        <p>
          <span class="font-medium text-gray-900 dark:text-white">Your account is secure.</span>
          All changes are logged and you'll receive email notifications for security-related updates.
        </p>
      </div>
    </div>
  </div>
</div>
