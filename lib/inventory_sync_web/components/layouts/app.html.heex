<div
  id="app-root"
  class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 font-sans text-slate-100 antialiased"
>
  <!-- Mobile Sidebar Overlay & Drawer -->
  <div id="mobile-sidebar" class="relative z-50 lg:hidden hidden" role="dialog" aria-modal="true">
    <div
      id="mobile-sidebar-backdrop"
      class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm transition-opacity opacity-0"
      aria-hidden="true"
      phx-click={
        JS.hide(
          to: "#mobile-sidebar",
          transition: {"transition-opacity ease-linear duration-300", "opacity-100", "opacity-0"}
        )
        |> JS.remove_class("opacity-100", to: "#mobile-sidebar-backdrop")
      }
    >
    </div>

    <div class="fixed inset-0 flex">
      <div
        id="mobile-sidebar-panel"
        class="relative mr-16 flex w-full max-w-xs flex-1 transform transition-transform -translate-x-full"
        phx-click-away={
          JS.hide(
            to: "#mobile-sidebar",
            transition:
              {"transition-opacity ease-linear duration-300", "opacity-100", "opacity-0"}
          )
        }
      >
        <div class="absolute left-full top-0 flex w-16 justify-center pt-5">
          <button
            type="button"
            class="-m-2.5 p-2.5"
            phx-click={
              JS.hide(
                to: "#mobile-sidebar",
                transition:
                  {"transition-opacity ease-linear duration-300", "opacity-100", "opacity-0"}
              )
            }
          >
            <span class="sr-only">Close sidebar</span>
            <.icon name="hero-x-mark" class="h-6 w-6 text-white" />
          </button>
        </div>
        
<!-- Mobile Sidebar Content -->
        <div class="flex grow flex-col gap-y-5 overflow-y-auto bg-slate-800 border-r border-slate-700/50 px-6 pb-4">
          <div class="flex h-16 shrink-0 items-center">
            <.logo size="md" />
          </div>
          <nav class="flex flex-1 flex-col">
            <ul role="list" class="flex flex-1 flex-col gap-y-7">
              <li>
                <ul role="list" class="-mx-2 space-y-1">
                  <li>
                    <.sidebar_link
                      href="/dashboard"
                      active={@current_path == "/dashboard"}
                      icon="hero-home"
                    >
                      Dashboard
                    </.sidebar_link>
                  </li>
                  <li>
                    <.sidebar_link
                      href="/products"
                      active={@current_path == "/products"}
                      icon="hero-cube"
                    >
                      Products
                    </.sidebar_link>
                  </li>
                  <li>
                    <.sidebar_link
                      href="/channels"
                      active={@current_path == "/channels"}
                      icon="hero-globe-alt"
                    >
                      Channels
                    </.sidebar_link>
                  </li>
                  <li>
                    <.sidebar_link
                      href="/metrics"
                      active={@current_path == "/metrics"}
                      icon="hero-chart-bar"
                    >
                      Metrics
                    </.sidebar_link>
                  </li>
                </ul>
              </li>
              <li>
                <div class="text-xs font-semibold leading-6 text-slate-500 uppercase tracking-wider">
                  Settings
                </div>
                <ul role="list" class="-mx-2 mt-2 space-y-1">
                  <li>
                    <.sidebar_link
                      href="/users/settings"
                      active={@current_path == "/users/settings"}
                      icon="hero-cog-6-tooth"
                    >
                      Account
                    </.sidebar_link>
                  </li>
                  <li>
                    <.sidebar_link
                      href="/settings/team"
                      active={@current_path == "/settings/team"}
                      icon="hero-users"
                    >
                      Team
                    </.sidebar_link>
                  </li>
                </ul>
              </li>
              <!-- Mobile Only: User & Logout -->
              <li class="mt-auto border-t border-slate-700/50 pt-4">
                <%= if @current_scope do %>
                  <div class="flex items-center gap-3 mb-4 px-2">
                    <div class="h-10 w-10 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white font-semibold shadow-lg shadow-emerald-500/25">
                      {String.first(@current_scope.user.email) |> String.upcase()}
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-medium text-white truncate">
                        {@current_scope.user.email}
                      </p>
                      <p class="text-xs text-slate-400">Account</p>
                    </div>
                  </div>
                  <.link
                    href={~p"/users/log-out"}
                    method="delete"
                    class="group flex gap-x-3 rounded-lg p-2.5 text-sm leading-6 font-medium text-red-400 hover:text-red-300 hover:bg-red-500/10 transition-all duration-200"
                  >
                    <.icon name="hero-arrow-right-on-rectangle" class="h-5 w-5 shrink-0" />
                    Sign out
                  </.link>
                <% end %>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
  
<!-- Desktop Sidebar -->
  <div class="hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 lg:flex-col sidebar-panel">
    <div class="flex grow flex-col gap-y-5 overflow-y-auto bg-slate-800/50 backdrop-blur-sm border-r border-slate-700/50 px-6 pb-4">
      <div class="flex h-16 shrink-0 items-center">
        <.link href={~p"/dashboard"} class="hover:opacity-90 transition-opacity">
          <.logo size="md" />
        </.link>
      </div>
      <nav class="flex flex-1 flex-col">
        <ul role="list" class="flex flex-1 flex-col gap-y-7">
          <li>
            <ul role="list" class="-mx-2 space-y-1">
              <li>
                <.sidebar_link
                  href="/dashboard"
                  active={@current_path == "/dashboard"}
                  icon="hero-home"
                >
                  Dashboard
                </.sidebar_link>
              </li>
              <li>
                <.sidebar_link
                  href="/products"
                  active={@current_path == "/products"}
                  icon="hero-cube"
                >
                  Products
                </.sidebar_link>
              </li>
              <li>
                <.sidebar_link
                  href="/channels"
                  active={@current_path == "/channels"}
                  icon="hero-globe-alt"
                >
                  Channels
                </.sidebar_link>
              </li>
              <li>
                <.sidebar_link href="/dev/dashboard" active={false} icon="hero-chart-bar">
                  Metrics
                </.sidebar_link>
              </li>
            </ul>
          </li>
          <li>
            <div class="text-xs font-semibold leading-6 text-slate-500 uppercase tracking-wider">
              Settings
            </div>
            <ul role="list" class="-mx-2 mt-2 space-y-1">
              <li>
                <.sidebar_link
                  href="/users/settings"
                  active={@current_path == "/users/settings"}
                  icon="hero-cog-6-tooth"
                >
                  Account
                </.sidebar_link>
              </li>
              <li>
                <.sidebar_link
                  href="/settings/team"
                  active={@current_path == "/settings/team"}
                  icon="hero-users"
                >
                  Team
                </.sidebar_link>
              </li>
            </ul>
          </li>
          <li class="mt-auto">
            <a
              href="#"
              class="group -mx-2 flex gap-x-3 rounded-lg p-2.5 text-sm font-medium leading-6 text-slate-400 hover:bg-slate-700/30 hover:text-emerald-400 transition-all duration-200"
            >
              <.icon
                name="hero-question-mark-circle"
                class="h-5 w-5 shrink-0 text-slate-500 group-hover:text-emerald-400 transition-colors"
              /> Help & Documentation
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
  
<!-- Main Content Area (Offset) -->
  <div class="flex flex-col min-h-screen lg:pl-72 app-content">
    <!-- Sticky Top Header -->
    <div class="sticky top-0 z-40 flex h-16 shrink-0 items-center gap-x-4 border-b border-slate-700/50 bg-slate-900/80 backdrop-blur-sm px-4 shadow-lg shadow-slate-900/20 sm:gap-x-6 sm:px-6 lg:px-8">
      <button
        type="button"
        class="-m-2.5 p-2.5 text-slate-400 hover:text-white lg:hidden transition-colors"
        phx-click={
          JS.show(
            to: "#mobile-sidebar",
            transition:
              {"transition-opacity ease-linear duration-300", "opacity-0", "opacity-100"}
          )
          |> JS.add_class("opacity-100", to: "#mobile-sidebar-backdrop")
          |> JS.remove_class("-translate-x-full", to: "#mobile-sidebar-panel")
        }
      >
        <span class="sr-only">Open sidebar</span>
        <.icon name="hero-bars-3" class="h-6 w-6" />
      </button>
      
<!-- Separator -->
      <div class="h-6 w-px bg-slate-700 lg:hidden" aria-hidden="true"></div>

      <div class="flex flex-1 gap-x-4 self-stretch lg:gap-x-6">
        <!-- Desktop Sidebar Collapse Toggle -->
        <button
          type="button"
          class="hidden lg:inline-flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-slate-400 hover:bg-slate-700/50 hover:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition-all duration-200"
          phx-click={JS.dispatch("sidebar:toggle")}
          aria-label="Toggle sidebar"
          title="Toggle sidebar"
        >
          <.icon name="hero-bars-3-bottom-left" class="h-5 w-5" />
        </button>
        
<!-- Search Bar -->
        <form class="relative flex flex-1" action="#" method="GET">
          <label for="search-field" class="sr-only">Search</label>
          <.icon
            name="hero-magnifying-glass"
            class="pointer-events-none absolute inset-y-0 left-0 h-full w-5 text-slate-500"
          />
          <input
            id="search-field"
            class="block h-full w-full border-0 py-0 pl-8 pr-0 text-white placeholder:text-slate-500 focus:ring-0 bg-transparent sm:text-sm"
            placeholder="Search products, channels..."
            type="search"
            name="search"
          />
        </form>

        <div class="flex items-center gap-x-4 lg:gap-x-6">
          <!-- Notifications -->
          <div class="relative group">
            <button class="-m-2.5 p-2.5 text-slate-400 hover:text-white transition-colors relative">
              <span class="sr-only">View notifications</span>
              <.icon name="hero-bell" class="h-6 w-6" />
              <span class="absolute top-1.5 right-1.5 h-2.5 w-2.5 rounded-full bg-red-500 ring-2 ring-slate-900 animate-pulse">
              </span>
            </button>
            <!-- Notification Dropdown -->
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 absolute right-0 mt-2 w-80 bg-slate-800 rounded-xl shadow-2xl ring-1 ring-slate-700/50 z-50 transition-all duration-200 origin-top-right border border-slate-700/50">
              <div class="px-4 py-3 border-b border-slate-700/50 flex items-center justify-between">
                <h3 class="text-sm font-semibold text-white">Notifications</h3>
                <span class="text-xs text-slate-400">2 new</span>
              </div>
              <div class="max-h-64 overflow-y-auto custom-scrollbar">
                <.notification_item
                  title="Sync Failed"
                  time="2m ago"
                  type="error"
                  message="Shopify sync failed for SKU-123."
                />
                <.notification_item
                  title="Low Stock"
                  time="1h ago"
                  type="warning"
                  message="Product 'Blue Shirt' is below 5 units."
                />
                <.notification_item
                  title="New Channel Connected"
                  time="3h ago"
                  type="success"
                  message="Successfully connected to Amazon marketplace."
                />
              </div>
              <div class="px-4 py-3 border-t border-slate-700/50">
                <a
                  href="#"
                  class="text-sm text-emerald-400 hover:text-emerald-300 font-medium transition-colors"
                >
                  View all notifications
                </a>
              </div>
            </div>
          </div>
          
<!-- Separator -->
          <div
            class="hidden lg:block lg:h-6 lg:w-px lg:bg-slate-700"
            aria-hidden="true"
          >
          </div>
          
<!-- User Profile -->
          <div class="relative group">
            <button
              type="button"
              class="-m-1.5 flex items-center p-1.5 rounded-lg hover:bg-slate-700/50 transition-colors"
              id="user-menu-button"
              aria-expanded="false"
              aria-haspopup="true"
            >
              <span class="sr-only">Open user menu</span>
              <%= if @current_scope do %>
                <div class="h-8 w-8 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white font-semibold text-sm shadow-lg shadow-emerald-500/25">
                  {String.first(@current_scope.user.email) |> String.upcase()}
                </div>
                <span class="hidden lg:flex lg:items-center">
                  <span
                    class="ml-3 text-sm font-medium leading-6 text-white max-w-[150px] truncate"
                    aria-hidden="true"
                  >
                    {@current_scope.user.email}
                  </span>
                  <.icon name="hero-chevron-down" class="ml-2 h-4 w-4 text-slate-400" />
                </span>
              <% else %>
                <div class="h-8 w-8 rounded-full bg-slate-700 flex items-center justify-center">
                  <.icon name="hero-user" class="h-5 w-5 text-slate-400" />
                </div>
              <% end %>
            </button>
            <!-- Profile Dropdown -->
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 absolute right-0 z-50 mt-2 w-56 origin-top-right rounded-xl bg-slate-800 shadow-2xl ring-1 ring-slate-700/50 border border-slate-700/50 focus:outline-none transition-all duration-200">
              <%= if @current_scope do %>
                <div class="px-4 py-3 border-b border-slate-700/50">
                  <p class="text-sm font-medium text-white truncate">
                    {@current_scope.user.email}
                  </p>
                  <p class="text-xs text-slate-400 mt-0.5">Manage your account</p>
                </div>
              <% end %>
              <div class="py-2">
                <a
                  href={~p"/users/settings"}
                  class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-slate-700/50 hover:text-white transition-colors"
                >
                  <.icon name="hero-user-circle" class="h-5 w-5 text-slate-400" /> Your Profile
                </a>
                <a
                  href={~p"/users/settings"}
                  class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-slate-700/50 hover:text-white transition-colors"
                >
                  <.icon name="hero-cog-6-tooth" class="h-5 w-5 text-slate-400" /> Settings
                </a>
                <a
                  href="#"
                  class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-slate-700/50 hover:text-white transition-colors"
                >
                  <.icon name="hero-credit-card" class="h-5 w-5 text-slate-400" /> Billing
                </a>
              </div>
              <div class="border-t border-slate-700/50 py-2">
                <.link
                  href={~p"/users/log-out"}
                  method="delete"
                  class="flex items-center gap-3 px-4 py-2 text-sm text-red-400 hover:bg-red-500/10 hover:text-red-300 transition-colors"
                >
                  <.icon name="hero-arrow-right-on-rectangle" class="h-5 w-5" /> Sign out
                </.link>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
<!-- Main Content -->
    <main class="flex-1 py-8">
      <div class="px-4 sm:px-6 lg:px-8">
        <.flash_group flash={@flash} />
        {@inner_content}
      </div>
    </main>
    
<!-- App Footer -->
    <.footer variant="minimal" class="lg:ml-0" />
  </div>
</div>
