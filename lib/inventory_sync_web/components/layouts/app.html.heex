<div
  id="app-root"
  class="min-h-screen bg-gray-50 dark:bg-gray-900 font-sans text-gray-900 dark:text-gray-100 antialiased"
>
  
<!-- Mobile Sidebar Overlay & Drawer -->
  <div id="mobile-sidebar" class="relative z-50 lg:hidden hidden" role="dialog" aria-modal="true">
    <div
      id="mobile-sidebar-backdrop"
      class="fixed inset-0 bg-gray-900/80 backdrop-blur-sm transition-opacity opacity-0"
      aria-hidden="true"
      phx-click={
        JS.hide(
          to: "#mobile-sidebar",
          transition: {"transition-opacity ease-linear duration-300", "opacity-100", "opacity-0"}
        )
        |> JS.remove_class("opacity-100", to: "#mobile-sidebar-backdrop")
      }
    >
    </div>

    <div class="fixed inset-0 flex">
      <div
        id="mobile-sidebar-panel"
        class="relative mr-16 flex w-full max-w-xs flex-1 transform transition-transform -translate-x-full"
        phx-click-away={
          JS.hide(
            to: "#mobile-sidebar",
            transition:
              {"transition-opacity ease-linear duration-300", "opacity-100", "opacity-0"}
          )
        }
      >
        <div class="absolute left-full top-0 flex w-16 justify-center pt-5">
          <button
            type="button"
            class="-m-2.5 p-2.5"
            phx-click={
              JS.hide(
                to: "#mobile-sidebar",
                transition:
                  {"transition-opacity ease-linear duration-300", "opacity-100", "opacity-0"}
              )
            }
          >
            <span class="sr-only">Close sidebar</span>
            <.icon name="hero-x-mark" class="h-6 w-6 text-white" />
          </button>
        </div>
        
<!-- Mobile Sidebar Content -->
        <div class="flex grow flex-col gap-y-5 overflow-y-auto bg-white dark:bg-gray-800 px-6 pb-4">
          <div class="flex h-16 shrink-0 items-center gap-2">
            <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold text-lg">
              I
            </div>
            <span class="text-xl font-bold text-gray-900 dark:text-white">Inventory</span>
          </div>
          <nav class="flex flex-1 flex-col">
            <ul role="list" class="flex flex-1 flex-col gap-y-7">
              <li>
                <ul role="list" class="-mx-2 space-y-1">
                  <li>
                    <.sidebar_link href="/" active={@current_path == "/"} icon="hero-home">
                      Dashboard
                    </.sidebar_link>
                  </li>
                  <li>
                    <.sidebar_link
                      href="/products"
                      active={@current_path == "/products"}
                      icon="hero-cube"
                    >
                      Products
                    </.sidebar_link>
                  </li>
                  <li>
                    <.sidebar_link
                      href="/channels"
                      active={@current_path == "/channels"}
                      icon="hero-globe-alt"
                    >
                      Channels
                    </.sidebar_link>
                  </li>
                  <li>
                    <.sidebar_link href="/metrics" active={@current_path == "/metrics"} icon="hero-chart-bar">
                      Metrics
                    </.sidebar_link>
                  </li>
                </ul>
              </li>
              <li>
                <div class="text-xs font-semibold leading-6 text-gray-400">Settings</div>
                <ul role="list" class="-mx-2 mt-2 space-y-1">
                  <li>
                    <.sidebar_link
                      href="/settings/general"
                      active={@current_path == "/settings/general"}
                      icon="hero-cog-6-tooth"
                    >
                      General
                    </.sidebar_link>
                  </li>
                  <li>
                    <.sidebar_link
                      href="/settings/team"
                      active={@current_path == "/settings/team"}
                      icon="hero-users"
                    >
                      Team
                    </.sidebar_link>
                  </li>
                </ul>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
  
<!-- Desktop Sidebar -->
  <div class="hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 lg:flex-col sidebar-panel">
    <div class="flex grow flex-col gap-y-5 overflow-y-auto border-r border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 px-6 pb-4">
      <div class="flex h-16 shrink-0 items-center gap-2">
        <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold text-lg shadow-lg shadow-indigo-200 dark:shadow-none">
          I
        </div>
        <span class="text-xl font-bold text-gray-900 dark:text-white">Inventory</span>
      </div>
      <nav class="flex flex-1 flex-col">
        <ul role="list" class="flex flex-1 flex-col gap-y-7">
          <li>
            <ul role="list" class="-mx-2 space-y-1">
              <li>
                <.sidebar_link href="/" active={@current_path == "/"} icon="hero-home">
                  Dashboard
                </.sidebar_link>
              </li>
              <li>
                <.sidebar_link
                  href="/products"
                  active={@current_path == "/products"}
                  icon="hero-cube"
                >
                  Products
                </.sidebar_link>
              </li>
              <li>
                <.sidebar_link
                  href="/channels"
                  active={@current_path == "/channels"}
                  icon="hero-globe-alt"
                >
                  Channels
                </.sidebar_link>
              </li>
              <li>
                <.sidebar_link href="/dev/dashboard" active={false} icon="hero-chart-bar">
                  Metrics
                </.sidebar_link>
              </li>
            </ul>
          </li>
          <li>
            <div class="text-xs font-semibold leading-6 text-gray-400">Settings</div>
            <ul role="list" class="-mx-2 mt-2 space-y-1">
              <li>
                <.sidebar_link
                  href="/settings/general"
                  active={@current_path == "/settings/general"}
                  icon="hero-cog-6-tooth"
                >
                  General
                </.sidebar_link>
              </li>
              <li>
                <.sidebar_link
                  href="/settings/team"
                  active={@current_path == "/settings/team"}
                  icon="hero-users"
                >
                  Team
                </.sidebar_link>
              </li>
            </ul>
          </li>
          <li class="mt-auto">
            <a
              href="#"
              class="group -mx-2 flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-700 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-indigo-600 dark:hover:text-white"
            >
              <.icon
                name="hero-question-mark-circle"
                class="h-6 w-6 shrink-0 text-gray-400 group-hover:text-indigo-600 dark:group-hover:text-white"
              /> Help & Documentation
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
  
<!-- Main Content Area (Offset) -->
  <div class="flex flex-col min-h-screen lg:pl-72 app-content">
    <!-- Sticky Top Header -->
    <div class="sticky top-0 z-40 flex h-16 shrink-0 items-center gap-x-4 border-b border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-gray-800/90 backdrop-blur-sm px-4 shadow-sm sm:gap-x-6 sm:px-6 lg:px-8">
      <button
        type="button"
        class="-m-2.5 p-2.5 text-gray-700 dark:text-gray-200 lg:hidden"
        phx-click={
          JS.show(
            to: "#mobile-sidebar",
            transition:
              {"transition-opacity ease-linear duration-300", "opacity-0", "opacity-100"}
          )
          |> JS.add_class("opacity-100", to: "#mobile-sidebar-backdrop")
          |> JS.remove_class("-translate-x-full", to: "#mobile-sidebar-panel")
        }
      >
        <span class="sr-only">Open sidebar</span>
        <.icon name="hero-bars-3" class="h-6 w-6" />
      </button>
      
<!-- Separator -->
      <div class="h-6 w-px bg-gray-200 dark:bg-gray-700 lg:hidden" aria-hidden="true"></div>

      <div class="flex flex-1 gap-x-4 self-stretch lg:gap-x-6">
        <!-- Desktop Sidebar Collapse Toggle -->
        <button
          type="button"
          class="hidden lg:inline-flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          phx-click={JS.dispatch("sidebar:toggle")}
          aria-label="Toggle sidebar"
          title="Toggle sidebar"
        >
          <.icon name="hero-sidebar" class="h-5 w-5" /> Collapse
        </button>
        <form class="relative flex flex-1" action="#" method="GET">
          <label for="search-field" class="sr-only">Search</label>
          <.icon
            name="hero-magnifying-glass"
            class="absolute inset-y-0 left-0 h-full w-5 text-gray-400"
          />
          <input
            id="search-field"
            class="block h-full w-full border-0 py-0 pl-8 pr-0 text-gray-900 dark:text-white placeholder:text-gray-400 focus:ring-0 bg-transparent sm:text-sm"
            placeholder="Search..."
            type="search"
            name="search"
          />
        </form>

        <div class="flex items-center gap-x-4 lg:gap-x-6">
          <!-- Notifications -->
          <div class="relative group">
            <button class="-m-2.5 p-2.5 text-gray-400 hover:text-gray-500 dark:hover:text-gray-300">
              <span class="sr-only">View notifications</span>
              <.icon name="hero-bell" class="h-6 w-6" />
              <span class="absolute top-2 right-2 h-2 w-2 rounded-full bg-red-500 ring-2 ring-white dark:ring-gray-800">
              </span>
            </button>
            <!-- Notification Dropdown (Same as before) -->
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 absolute right-0 mt-2 w-80 bg-white dark:bg-gray-800 rounded-xl shadow-lg ring-1 ring-black ring-opacity-5 z-50 transition-all origin-top-right">
              <div class="px-4 py-3 border-b border-gray-100 dark:border-gray-700">
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Notifications</h3>
              </div>
              <div class="max-h-64 overflow-y-auto custom-scrollbar">
                <.notification_item
                  title="Sync Failed"
                  time="2m ago"
                  type="error"
                  message="Shopify sync failed for SKU-123."
                />
                <.notification_item
                  title="Low Stock"
                  time="1h ago"
                  type="warning"
                  message="Product 'Blue Shirt' is below 5 units."
                />
              </div>
            </div>
          </div>
          
<!-- Separator -->
          <div
            class="hidden lg:block lg:h-6 lg:w-px lg:bg-gray-200 dark:lg:bg-gray-700"
            aria-hidden="true"
          >
          </div>

          <.theme_toggle />
          
<!-- User Profile -->
          <div class="relative group">
            <button
              type="button"
              class="-m-1.5 flex items-center p-1.5"
              id="user-menu-button"
              aria-expanded="false"
              aria-haspopup="true"
            >
              <span class="sr-only">Open user menu</span>
              <img
                class="h-8 w-8 rounded-full bg-gray-50"
                src="https://ui-avatars.com/api/?name=Admin+User&background=6366f1&color=fff"
                alt=""
              />
              <span class="hidden lg:flex lg:items-center">
                <span
                  class="ml-4 text-sm font-semibold leading-6 text-gray-900 dark:text-white"
                  aria-hidden="true"
                >
                  Admin User
                </span>
                <.icon name="hero-chevron-down" class="ml-2 h-5 w-5 text-gray-400" />
              </span>
            </button>
            <!-- Profile Dropdown -->
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 absolute right-0 z-50 mt-2.5 w-32 origin-top-right rounded-md bg-white dark:bg-gray-800 py-2 shadow-lg ring-1 ring-gray-900/5 focus:outline-none transition-all">
              <a
                href="#"
                class="block px-3 py-1 text-sm leading-6 text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-700"
              >
                Your Profile
              </a>
              <a
                href="#"
                class="block px-3 py-1 text-sm leading-6 text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-700"
              >
                Settings
              </a>
              <a
                href="#"
                class="block px-3 py-1 text-sm leading-6 text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-700"
              >
                Sign out
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <main class="py-10">
      <div class="px-4 sm:px-6 lg:px-8">
        <.flash_group flash={@flash} />
        {@inner_content}
      </div>
    </main>
  </div>
</div>
